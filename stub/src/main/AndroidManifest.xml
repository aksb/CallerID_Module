<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        这里故意不声明任何 Activity/Service/Receiver，尤其是不声明任何
        LAUNCHER intent-filter：这样占位 APK 装在系统分区之后，不会出现在
        桌面上，也就不存在"用户看到一个默认安卓机器人图标、点开就闪退"这种
        体验问题——真正的 App 装上去之前，它在系统里就是完全不可见、
        不可交互的一个空壳。

        v4.3 起不再声明 android:persistent="true"（原因见 :app 那边
        AndroidManifest.xml 里的说明——persistent 状态下的包名会被系统禁止
        `pm install` 更新，跟这个模块"顺序无关、随便装随便更新"的设计目标
        直接冲突，已确认踩到过这个限制，因此去掉）。这里只保留"变成系统
        应用、拿 priv-app 待遇"这部分效果。
    -->
    <application
        android:label="来电识别"
        android:icon="@android:drawable/ic_menu_call"
        android:allowBackup="false"
        android:hasCode="false">
    </application>

</manifest>
