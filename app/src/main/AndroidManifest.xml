<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 来电状态（辅助，Hook 是主路径） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- 悬浮窗（核心权限） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 网络（查询百度 API） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 强制走蜂窝网络查询所需（即使 WiFi 已连接） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        v4.9 清理：REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 权限已经没有用了——申请这个
        权限用的"🔋 申请忽略电池优化（无需 Root）"按钮，在"Root保活教程"改成
        ①②③➃弹窗式设计那一轮（v4.5）就已经删掉了，Java 代码里再也没有地方
        引用这个权限，属于遗留下来忘记一起清的死代码，这次顺手去掉。
    -->

    <!-- ❌ 已移除 FOREGROUND_SERVICE 和 FOREGROUND_SERVICE_PHONE_CALL -->
    <!-- 改为普通 Service，彻底规避 Android 14+ 的前台服务类型校验崩溃 -->

    <!--
        v4.2 曾经加过 android:persistent="true"，v4.3 起彻底去掉：这个属性一旦
        在系统应用状态下真正生效，会触发安卓一条硬性限制——处于 persistent
        状态的包名，之后任何 `pm install` 更新都会被系统直接拒绝，报
        "Persistent apps are not updateable"，没有绕过办法，只能先完整卸载
        再重装。这跟"系统化模块顺序无关、随便装随便更新"这个目标直接冲突，
        实测中也确认踩到了这个限制，所以去掉，改为只保留"变成系统应用、
        拿 priv-app 待遇"这部分效果，不再追求 persistent 那种更激进的
        内存回收优先级。
    -->
    <application
        android:label="来电识别"
        android:icon="@android:drawable/ic_menu_call"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- LSPosed 模块声明 -->
        <meta-data android:name="xposedmodule"      android:value="true" />
        <meta-data android:name="xposeddescription"  android:value="来电号码识别悬浮窗" />
        <meta-data android:name="xposedminversion"   android:value="93" />
        <!--
            v4.9 新增：作用域推荐列表。HookEntry 挂的是 TelephonyRegistry，这个类
            本来就运行在 system_server（"系统框架"）进程里，本模块要生效，用户
            必须在 LSPosed 的作用域勾选界面里手动找到并勾上"系统框架"——之前
            LSPosed 的推荐列表里没有把它顶到前面，用户容易漏勾。这里用官方支持
            的 xposedscope 声明把 "android"（系统框架的包名）标记为推荐项，
            LSPosed 会把它置顶显示，降低漏勾的概率。
        -->
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            普通 Service（已去掉 foregroundServiceType）
            Android 14+ 前台服务 phoneCall 类型需要成为默认拨号应用，
            本模块不是拨号应用，使用普通 Service 规避 SecurityException。
            悬浮窗靠 SYSTEM_ALERT_WINDOW 权限弹出，不依赖前台服务。
        -->
        <service
            android:name=".FloatWindowService"
            android:exported="false" />

        <!--
            本地查询服务（v3.19 新增，"结合 SpamBlocker 拦截器"功能）：只监听 127.0.0.1，
            同理不用前台服务类型，规避 Android 14+ 的 FGS 类型校验。
            exported=false：只允许本 App 自己（MainActivity/BootReceiver）启动，
            外部 App 不能直接 startService 拉起它，联动鉴权靠 HTTP 层的 token。
        -->
        <service
            android:name=".QueryServerService"
            android:exported="false" />

        <!-- 开机自启 -->
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 接收 Hook 广播 -->
        <receiver android:name=".CallReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.callerid.ACTION_INCOMING" />
                <action android:name="com.callerid.ACTION_IDLE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
