<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 来电状态（辅助，Hook 是主路径） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- 悬浮窗（核心权限） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 网络（查询百度 API） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 强制走蜂窝网络查询所需（即使 WiFi 已连接） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        申请忽略电池优化用（v4.0 新增，"Root保活教程"板块里"申请忽略电池优化
        （无需 Root）"按钮需要这个权限才能弹出系统那个"允许后台运行"对话框）。
        这是普通权限，安装时自动授予，不会弹运行时权限请求框。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ❌ 已移除 FOREGROUND_SERVICE 和 FOREGROUND_SERVICE_PHONE_CALL -->
    <!-- 改为普通 Service，彻底规避 Android 14+ 的前台服务类型校验崩溃 -->

    <!--
        v4.2 新增：android:persistent="true"。这一行对普通安装的 APK 完全没有
        任何效果——安卓只对系统应用（/system 分区、平台签名或 priv-app）承认这个
        属性，非系统应用的话会被系统直接忽略，加不加都不影响你现在装的这个普通
        版本。只有配合另外的"系统化增强" Magisk 模块把本 App 变成系统应用之后，
        这一行才会真正生效：系统会把这个进程按接近系统核心进程的优先级对待，
        内存紧张时尽量最后才考虑回收，用来缓解低内存机型上"常驻实例被系统按
        内存压力回收"这种情况（这不是 Doze/电池优化那一套机制，是另一套基于
        进程重要性打分的内存回收机制，appops 保活命令覆盖不到这里）。
    -->
    <application
        android:label="来电识别"
        android:icon="@android:drawable/ic_menu_call"
        android:allowBackup="false"
        android:persistent="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- LSPosed 模块声明 -->
        <meta-data android:name="xposedmodule"      android:value="true" />
        <meta-data android:name="xposeddescription"  android:value="来电号码识别悬浮窗" />
        <meta-data android:name="xposedminversion"   android:value="93" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            普通 Service（已去掉 foregroundServiceType）
            Android 14+ 前台服务 phoneCall 类型需要成为默认拨号应用，
            本模块不是拨号应用，使用普通 Service 规避 SecurityException。
            悬浮窗靠 SYSTEM_ALERT_WINDOW 权限弹出，不依赖前台服务。
        -->
        <service
            android:name=".FloatWindowService"
            android:exported="false" />

        <!--
            本地查询服务（v3.19 新增，"结合 SpamBlocker 拦截器"功能）：只监听 127.0.0.1，
            同理不用前台服务类型，规避 Android 14+ 的 FGS 类型校验。
            exported=false：只允许本 App 自己（MainActivity/BootReceiver）启动，
            外部 App 不能直接 startService 拉起它，联动鉴权靠 HTTP 层的 token。
        -->
        <service
            android:name=".QueryServerService"
            android:exported="false" />

        <!-- 开机自启 -->
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 接收 Hook 广播 -->
        <receiver android:name=".CallReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.callerid.ACTION_INCOMING" />
                <action android:name="com.callerid.ACTION_IDLE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
